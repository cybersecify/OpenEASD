# OpenEASD — environment template. Copy to .env and edit for local dev.
#   cp .env.example .env
# .env is gitignored. Values below are the local-dev defaults; only SECRET_KEY
# and the DB block are needed to boot. Everything else is optional.

# ── Core ─────────────────────────────────────────────────────────────────────
# Generate: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-domain.example   # required when DEBUG=false behind TLS

# ── Database (PostgreSQL — required; no SQLite) ───────────────────────────────
# Native local Postgres (the `just dev` / `make dev` path). Create it once:
#   createdb openeasd && createuser openeasd   (or use your own role/db below)
DB_NAME=openeasd
DB_USER=openeasd
DB_PASSWORD=openeasd
DB_HOST=127.0.0.1
DB_PORT=5432
# Or set a single URL instead of the DB_* block (wins if set):
# DATABASE_URL=postgres://openeasd:openeasd@127.0.0.1:5432/openeasd
# DBOS_DATABASE_URL=            # isolate the DBOS durable-execution schema (defaults to the app DB)
# DBOS_SCAN_CONCURRENCY=2       # max scans executing at once

# ── Scanner tool paths ───────────────────────────────────────────────────────
# Only needed if the binaries aren't on PATH. macOS/pdtm example paths:
# TOOL_SUBFINDER=~/.pdtm/go/bin/subfinder
# TOOL_DNSX=~/.pdtm/go/bin/dnsx
# TOOL_NAABU=~/.pdtm/go/bin/naabu
# TOOL_HTTPX=~/.pdtm/go/bin/httpx
# TOOL_KATANA=~/.pdtm/go/bin/katana
# TOOL_NUCLEI=~/.pdtm/go/bin/nuclei
# TOOL_NMAP=/opt/homebrew/bin/nmap
# TOOL_AMASS=/opt/homebrew/bin/amass
# TOOL_ALTERX=~/.pdtm/go/bin/alterx
# TOOL_GAU=~/go/bin/gau
# TOOL_CLOUD_ENUM=cloud_enum
# TOOL_GITLEAKS=gitleaks

# ── Scheduler ────────────────────────────────────────────────────────────────
# SCHEDULED_SCANS_ENABLED=true   # master switch for unattended daily/monitoring scans
# SCHEDULER_ENABLED=true         # registers the DBOS cron workflows at all
# SCAN_DAILY_HOUR=2
# SCAN_DAILY_MINUTE=0

# ── Notifications (optional) ─────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=
# MS_TEAMS_WEBHOOK_URL=
# ALERT_SEVERITY_THRESHOLD=high  # critical|high|medium|low|info

# ── BYOK scanner API keys (optional — richer results; UI /credentials wins over these) ──
# SHODAN_API_KEY=                # else free InternetDB tier
# HIBP_API_KEY=                  # else free XposedOrNot breach tier
# GITHUB_TOKEN=                  # raises GitHub API limits; required for github_secrets
# GITHUB_ORG=                    # override the domain-derived org for github recon
# DNS_HISTORY_API_URL=           # BYO passive-DNS endpoint for dns_history (no-op if unset)

# ── AI layer (optional — Cloudflare Workers AI, off by default) ──────────────
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ── Secrets at rest (optional) ───────────────────────────────────────────────
# Fernet key for encrypting BYOK creds in the DB; derived from SECRET_KEY if unset.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=
